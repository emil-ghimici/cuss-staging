<!doctype html>
<html lang="en-IE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
{%- set pageUrl = page.url | absUrl(env.url + '/') %}
{%- if env.staging %}
<meta name="robots" content="noindex,nofollow">
{%- else %}
<link rel="canonical" href="{{ pageUrl }}">
{%- endif %}
<meta name="tdm-reservation" content="1">
<meta name="theme-color" content="#0b0f14">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/atkinson-hyperlegible-next-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<meta property="og:type" content="website">
<meta property="og:site_name" content="CuSS Custom Software Solutions">
<meta property="og:locale" content="en_IE">
<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:image" content="{{ (ogImage or '/assets/og/' + (page.url | ogSlug) + '.png') | absUrl(env.url + '/') }}">
<meta property="og:image:alt" content="{{ ogTitle or title }}: CuSS Custom Software Solutions, Athlone">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
{#- Theme and motion before first paint. Motion (design README rule 9): the device's reduced-motion setting by default,
    the visitor's switch (cuss-motion: play | still) overrides it. html.still = nothing moves; html.still-os = still only
    because of the device setting, which shows the hero's "Play animation" line. The only reader of the media query. #}
<script>(function(d){d.classList.add('js');var m,r=window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches;try{var t=localStorage.getItem('cuss-theme');if(t==='light'||t==='dark')d.setAttribute('data-theme',t);m=localStorage.getItem('cuss-motion')}catch(e){}if(m==='still'||(m!=='play'&&r))d.classList.add('still');if(r&&m!=='play'&&m!=='still')d.classList.add('still-os')})(document.documentElement)</script>
<style>{% inlineCss css %}</style>
{%- include "partials/jsonld.njk" %}
</head>
<body class="{{ bodyClass }}"{% if crewPerches %} data-crew-perches="{{ crewPerches }}"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
{% include "partials/header.njk" %}
<main id="main" tabindex="-1">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{% include "partials/guide.njk" %}
<script src="/assets/js/site.js" defer></script>
<script src="/assets/js/guide.js" defer></script>
{%- for s in scripts %}
<script src="/assets/js/{{ s }}.js" defer></script>
{%- endfor %}
</body>
</html>
