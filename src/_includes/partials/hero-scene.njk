<div class="scene" aria-hidden="true">
  <svg class="street" viewBox="0 0 640 520" preserveAspectRatio="xMidYMax slice" focusable="false">
    <path class="ln2" d="M0 250V150h60v-40h50v70h40V90h70v60h30v-30h60v80h40V70h80v110h40v-50h60v90h60"/>
    <g class="win-a"><rect x="168" y="110" width="6" height="8"/><rect x="186" y="130" width="6" height="8"/><rect x="420" y="96" width="6" height="8"/><rect x="438" y="140" width="6" height="8"/><rect x="72" y="166" width="6" height="8"/></g>
    <g class="win-h"><rect x="404" y="120" width="6" height="8"/><rect x="530" y="160" width="6" height="8"/></g>
    <path class="ln" d="M0 300h640"/>
    <path class="ln2" d="M30 330h40M110 360h60M500 340h50M560 380h40"/>
    <path class="cable" d="M0 40Q160 120 330 50T640 70"/><path class="cable" d="M0 70Q120 130 260 90"/>
    <path class="ln" d="M490 92v-14M610 92v-14"/>
    <path class="sig flick" data-tube d="M480 96h140"/>
    <!-- Street lamp (the street sign hangs off its post): amber head, its light and pool; dark when the bulb goes -->
    <g class="lamp" data-lamp>
      <path class="lamp-cone" d="M86 74L48 470h88L98 74z"/>
      <ellipse class="lamp-pool" cx="92" cy="470" rx="46" ry="6"/>
      <path class="ln" d="M60 470V74q0-12 12-12h10"/>
      <path class="lamp-head" d="M80 58h24l-4 12h-16z"/>
      <ellipse class="lamp-bulb" cx="92" cy="73" rx="7" ry="3.5"/>
    </g>
    <g data-sign transform="rotate(-9 75 270)"><rect class="blk2" x="16" y="252" width="112" height="36" stroke="var(--amber)" stroke-width="2"/><text class="txt-amb" x="72" y="276" text-anchor="middle">MILL ST.</text></g>
    <path class="cable" d="M640 120Q600 220 585 330"/>
    <rect class="blk2" x="560" y="330" width="52" height="66" stroke="var(--divider)" stroke-width="2"/>
    <path class="hazs" d="M572 352l10 -10 10 10 -10 10z"/>
    <g class="spark" data-spark><path d="M556 334l-12-8M556 340l-16 2M560 328l-4-14" stroke="var(--hazard)" stroke-width="2.5" stroke-linecap="round"/></g>
    <path class="ln" d="M0 470h640"/>
    <path d="M500 486h90M520 494h50" stroke="var(--signal)" stroke-width="2" opacity=".35"/>
    <path d="M120 490h120" stroke="var(--amber)" stroke-width="2" opacity=".3"/>
  </svg>
  <div class="tv bv-lg"><div class="tv-screen bv-md"><canvas width="320" height="256"></canvas><div class="scan"></div><div class="vign"></div></div><span class="dial d1"></span><span class="dial d2"></span><span class="grille"></span><span class="legs"></span><span class="bucket"></span></div>
  <span class="pipe"><span class="pipe-joint" data-joint></span></span><span class="drop"></span>
  <span class="crate" aria-hidden="true"></span>
  <div class="crew reach flip">{% include "svg/crew.njk" %}</div>
</div>
